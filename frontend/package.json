    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitest/coverage-v8": "2.0.5",
    "@vitejs/plugin-react": "4.3.1",
    "eslint": "9.9.1",
    "eslint-plugin-react-hooks": "5.1.0-rc.0",
    "globals": "15.9.0",
    "jsdom": "25.0.1",
    "typescript": "5.5.4",
    "typescript-eslint": "8.4.0",
    "vite": "5.4.2",
    "vitest": "2.0.5"
