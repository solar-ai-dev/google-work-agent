# ------------------------------------------------------------
# Python virtual environments
# ------------------------------------------------------------
.venv/
.venv-*/
venv/
env/
ENV/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.pytype/
.dmypy.json
dmypy.json

# Coverage / test reports
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml
.pytest-results/
test-results/

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
.pyinstaller/
*.spec

# ------------------------------------------------------------
# Secrets and local configuration
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
client_secret*.json
credentials*.json
token*.json
oauth-client*.json
service-account*.json

# Local app settings that vary by machine
app-settings.local.json
settings.local.json
config.local.*

# ------------------------------------------------------------
# Google Work Agent local runtime data
# ------------------------------------------------------------
/data/
/backups/
/logs/
/diagnostics/
/runtime/
/cache/
/local-data/

*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.log
*.jsonl
!/evaluation/datasets/**/*.jsonl
*.dmp
*.dump
crash-*.txt

# Evaluation outputs: keep curated fixtures/datasets, ignore transient runs
/evaluation/results/
/evaluation/cache/
/evaluation/raw-results/
artifacts/
reports/generated/

# Local model files must never enter Git
models/
*.gguf
*.safetensors
*.onnx
*.pt
*.pth

# ------------------------------------------------------------
# Frontend / Node
# ------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
.npm/
.pnpm-store/
.yarn/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------
# IDE / OS
# ------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo
~$*

# ------------------------------------------------------------
