{
  "schema_version": 1,
  "contract_id": "prompt-runtime-input-contract-v1-r8.6-phase6",
  "source_of_truth": "Runtime typed projection schemas, not evaluation projections",
  "forbidden_runtime_fields": [
    "end_state_gold",
    "decision_script",
    "fault_script",
    "six_reference_route",
    "grader_ids",
    "expected_route",
    "benchmark_score",
    "dataset_split",
    "holdout_label"
  ],
  "rules": [
    "Only declared runtime input fields may be serialized into a Product Prompt.",
    "Evaluation projection objects are never passed directly to Product Prompt assembly.",
    "Repair/revision receives only base_projection + candidate_output + normalized failure_record.",
    "Connector source text stays DATA_ONLY and cannot grant authority.",
    "Holdout data is not used for prompt authoring or tuning."
  ],
  "retired_slots": {
    "request_understanding.classify.revise": {
      "reason": "Schema-valid-but-semantically-incomplete RequestIntentV2 candidates (missing goal, missing completion_conditions, unresolved ambiguity) are routed deterministically to NEEDS_CONFIRMATION by request_understanding.py::_classify_valid_intent, which builds the clarification question in Python -- no LLM re-judgment call is issued. This is WORKFLOW_REDIRECTION (15 section 7), not SEMANTIC_REVISION.",
      "replaced_by": "google_work_agent.application.workflows.request_understanding._classify_valid_intent"
    },
    "retrieval.assess_sufficiency.revise": {
      "reason": "The LLM's SufficiencyResultV2.status is a candidate only. retrieval_sufficiency.py::enforce_sufficiency_guard deterministically recomputes the authoritative disposition via the same decide_insufficient_data engine supervisor._route_additional_acquisition uses, and overrides the LLM status whenever they disagree -- no LLM re-judgment call is issued.",
      "replaced_by": "google_work_agent.application.workflows.retrieval_sufficiency.enforce_sufficiency_guard"
    },
    "work_analysis.analyze.reassess": {
      "reason": "work_analysis's semantic_validate failures (finding cross-reference / invariant violations) share the same one-attempt repair budget as shape failures by explicit framework design (application/llm.py StructuredLLMRuntime.invoke_structured docstring cites work_analysis as the reference case) -- there is no separate SEMANTIC_REVISION call site for this node.",
      "replaced_by": "google_work_agent.application.llm.SchemaRepairer (generic .repair budget covers semantic_validate failures for this node)"
    }
  },
  "slots": {
