# Migration documentation and runtime copies are compared as raw bytes.
*.sql text eol=lf

# Product and Evaluation Prompt artifacts are SHA-256 verified byte-for-byte.
# Pin JSON as well as source text so Windows checkout cannot change bundle identity.
src/google_work_agent/application/prompt_runtime/*.json text eol=lf
src/google_work_agent/application/prompt_runtime/sources/*.md text eol=lf
evaluation/prompt_candidates/** text eol=lf

# Evaluation configs, datasets, and provenance use deterministic UTF-8 LF serialization.
evaluation/**/*.json text eol=lf
evaluation/**/*.jsonl text eol=lf
evaluation/**/*.md text eol=lf
