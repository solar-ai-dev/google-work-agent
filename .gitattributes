# Migration documentation and runtime copies are compared as raw bytes.
*.sql text eol=lf

# Assembled prompt artifacts are SHA-256 verified byte-for-byte against
# prompt-manifest-v0.8.3.json at LLM-call time (prompt_registry.py). This
# entry was committed with LF; without pinning eol=lf, Windows core.autocrlf
# checkout rewrites it to CRLF and breaks the manifest's assembled_hash.
evaluation/prompt_candidates/planning-review-sllm-decomposition-v0.9.2/**/*.md text eol=lf

# Current Prompt Registry verifies source bytes against manifest SHA-256.
src/google_work_agent/application/prompt_runtime/sources/*.md text eol=lf
evaluation/prompt_candidates/** text eol=lf

# Current Evaluation source artifacts use deterministic UTF-8 LF serialization.
evaluation/datasets/*.jsonl text eol=lf
evaluation/datasets/micro/*.jsonl text eol=lf
evaluation/projections/data/*.jsonl text eol=lf
evaluation/compat/experiments/user_prompts/*.jsonl text eol=lf
evaluation/fixtures/data/** text eol=lf
