{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mutated-upstream-item-v1.schema.json",
  "title": "Mutated Upstream Item v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_item_id",
    "source_case_id",
    "fixture_snapshot_id",
    "target_node_id",
    "upstream_projection_ref",
    "mutation",
    "expected_behavior",
    "grader_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evaluation_item_id": {
      "type": "string"
    },
    "source_case_id": {
      "type": "string"
    },
    "fixture_snapshot_id": {
      "type": "string"
    },
    "target_node_id": {
      "type": "string"
    },
    "upstream_projection_ref": {
      "type": "string"
    },
    "mutation": {
      "type": "object",
      "required": [
        "operator",
        "semantic_target"
      ],
      "properties": {
        "operator": {
          "type": "string"
        },
        "semantic_target": {
          "type": "string"
        },
        "value": {}
      },
      "additionalProperties": false
    },
    "expected_behavior": {
      "type": "object"
    },
    "grader_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
