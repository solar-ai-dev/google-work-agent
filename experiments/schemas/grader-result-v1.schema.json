{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grader-result-v1.schema.json",
  "title": "Grader Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "evaluation_item_id",
    "candidate_config_hash",
    "trial_index",
    "grader_id",
    "grader_version",
    "result",
    "mismatch_codes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string"
    },
    "evaluation_item_id": {
      "type": "string"
    },
    "candidate_config_hash": {
      "type": "string"
    },
    "trial_index": {
      "type": "integer"
    },
    "grader_id": {
      "type": "string"
    },
    "grader_version": {
      "type": "string"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_APPLICABLE"
      ]
    },
    "mismatch_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "details": {
      "type": "object"
    }
  }
}
