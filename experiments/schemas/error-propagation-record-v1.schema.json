{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error-propagation-record-v1.schema.json",
  "title": "ErrorPropagationRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "evaluation_item_id",
    "failure_origin_agent",
    "failure_origin_stage",
    "failure_reason_code",
    "next_stage_detected",
    "corrected_before_handoff",
    "propagated_to_stage",
    "propagation_depth",
    "amplified",
    "final_outcome_impact",
    "deterministic_validator_caught"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string"
    },
    "evaluation_item_id": {
      "type": "string"
    },
    "failure_origin_agent": {
      "type": "string"
    },
    "failure_origin_stage": {
      "type": "string"
    },
    "failure_reason_code": {
      "type": "string"
    },
    "next_stage_detected": {
      "type": "boolean"
    },
    "corrected_before_handoff": {
      "type": "boolean"
    },
    "propagated_to_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "propagation_depth": {
      "type": "integer",
      "minimum": 0
    },
    "amplified": {
      "type": "boolean"
    },
    "final_outcome_impact": {
      "enum": [
        "NONE",
        "QUALITY_DEGRADED",
        "WRONG_ROUTE",
        "WRONG_PLAN",
        "SAFETY_BLOCK",
        "RUN_FAILED"
      ]
    },
    "deterministic_validator_caught": {
      "type": "boolean"
    }
  }
}
