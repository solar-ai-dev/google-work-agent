{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-config-v1.schema.json",
  "title": "Candidate Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "candidate_kind",
    "runnable",
    "dataset_version",
    "graph_version",
    "prompt_bundle_version",
    "agent_schema_version",
    "tool_schema_version",
    "policy_version",
    "retrieval_config_version",
    "runtime",
    "prompt_overrides",
    "budgets",
    "candidate_config_hash"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_id": {
      "type": "string"
    },
    "candidate_kind": {
      "enum": [
        "BASELINE_TEMPLATE",
        "PROMPT_OVERRIDE_TEMPLATE",
        "MODEL_CANDIDATE_TEMPLATE",
        "RESOLVED"
      ]
    },
    "runnable": {
      "type": "boolean"
    },
    "dataset_version": {
      "type": "string"
    },
    "graph_version": {
      "type": "string"
    },
    "prompt_bundle_version": {
      "type": "string"
    },
    "agent_schema_version": {
      "type": "string"
    },
    "tool_schema_version": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "retrieval_config_version": {
      "type": "string"
    },
    "runtime": {
      "type": "object",
      "required": [
        "runtime_mode",
        "provider",
        "model",
        "model_version",
        "parameters"
      ],
      "properties": {
        "runtime_mode": {
          "enum": [
            "API_LLM",
            "LOCAL_GPU",
            "AUTO"
          ]
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        },
        "hardware_profile": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "prompt_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "budgets": {
      "type": "object"
    },
    "unresolved_bindings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_config_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
