{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment-manifest-v1.schema.json",
  "title": "Experiment Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "experiment_family",
    "sub_experiment",
    "status",
    "independent_variable",
    "fixed_dimensions",
    "dataset_selection_ref",
    "candidate_config_refs",
    "grader_registry_ref",
    "trial_policy",
    "budget_policy",
    "preconditions",
    "result_artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_family": {
      "enum": [
        "E01",
        "E02",
        "E03",
        "E04",
        "E05",
        "E06",
        "E07",
        "E08",
        "G00",
        "G01",
        "G02",
        "V01"
      ]
    },
    "sub_experiment": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PREPARED_BLOCKED",
        "READY",
        "LOCKED_HOLDOUT",
        "ANALYSIS_ONLY"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "independent_variable": {
      "type": "string",
      "minLength": 1
    },
    "fixed_dimensions": {
      "type": "object"
    },
    "dataset_selection_ref": {
      "type": "string"
    },
    "candidate_config_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0
    },
    "grader_registry_ref": {
      "type": "string"
    },
    "trial_policy": {
      "type": "object"
    },
    "budget_policy": {
      "type": "object"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety_gate": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  }
}
