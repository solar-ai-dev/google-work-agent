{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config-diff-v1.schema.json",
  "title": "Candidate Config Diff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_candidate_id",
    "challenger_candidate_id",
    "allowed_independent_variable",
    "differences",
    "valid_single_variable_diff"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "baseline_candidate_id": {
      "type": "string"
    },
    "challenger_candidate_id": {
      "type": "string"
    },
    "allowed_independent_variable": {
      "type": "string"
    },
    "differences": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "valid_single_variable_diff": {
      "type": "boolean"
    },
    "block_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
