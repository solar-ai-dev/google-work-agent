{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "budget-report-v1.schema.json",
  "title": "Budget Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "candidate_config_hash",
    "item_started",
    "item_completed",
    "llm_calls",
    "provider_requests",
    "input_tokens",
    "output_tokens",
    "cost_usd",
    "budget_stopped"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string"
    },
    "candidate_config_hash": {
      "type": "string"
    },
    "item_started": {
      "type": "integer"
    },
    "item_completed": {
      "type": "integer"
    },
    "llm_calls": {
      "type": "integer"
    },
    "provider_requests": {
      "type": "integer"
    },
    "input_tokens": {
      "type": "integer"
    },
    "output_tokens": {
      "type": "integer"
    },
    "cost_usd": {
      "type": "number"
    },
    "budget_stopped": {
      "type": "boolean"
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
