{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-config-v2.schema.json",
  "title": "Candidate Config v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "candidate_kind",
    "runnable",
    "dataset_version",
    "graph_version",
    "prompt_bundle_version",
    "prompt_semantic_bundle_version",
    "agent_schema_version",
    "tool_schema_version",
    "policy_version",
    "retrieval_config_version",
    "graph_profile_spec",
    "runtime",
    "evaluation_environment",
    "prompt_overrides",
    "budgets",
    "candidate_config_hash"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "candidate_id": {
      "type": "string"
    },
    "candidate_kind": {
      "enum": [
        "BASELINE_TEMPLATE",
        "PROMPT_OVERRIDE_TEMPLATE",
        "MODEL_CANDIDATE_TEMPLATE",
        "RESOLVED"
      ]
    },
    "runnable": {
      "type": "boolean"
    },
    "dataset_version": {
      "type": "string"
    },
    "graph_version": {
      "type": "string"
    },
    "prompt_bundle_version": {
      "type": "string"
    },
    "prompt_semantic_bundle_version": {
      "type": "string"
    },
    "agent_schema_version": {
      "type": "string"
    },
    "tool_schema_version": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "retrieval_config_version": {
      "type": "string"
    },
    "graph_profile_spec": {
      "type": "object"
    },
    "runtime": {
      "type": "object"
    },
    "evaluation_environment": {
      "type": "object"
    },
    "prompt_overrides": {
      "type": "object"
    },
    "budgets": {
      "type": "object"
    },
    "unresolved_bindings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_config_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
