{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/node-evaluation-item.schema.json",
  "title": "NodeEvaluationItemV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_item_id",
    "split",
    "target_agent",
    "target_node_id",
    "source_case_id",
    "fixture_snapshot_id",
    "upstream_mode",
    "input_condition",
    "input_ref",
    "gold_ref",
    "initial_prompt_slot_id",
    "expected_initial_result",
    "injected_failure_reason_code",
    "expected_retry_kind",
    "expected_retry_prompt_slot_id",
    "expected_final_result",
    "max_attempts",
    "forbidden_transitions",
    "grader_ids",
    "scenario_family_id",
    "fixture_relation_family"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evaluation_item_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "DEV",
        "HOLDOUT"
      ]
    },
    "target_agent": {
      "enum": [
        "request_understanding",
        "acquisition",
        "context_retriever",
        "work_analysis",
        "planning",
        "review"
      ]
    },
    "target_node_id": {
      "type": "string",
      "minLength": 1
    },
    "source_case_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "fixture_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "upstream_mode": {
      "enum": [
        "ORACLE",
        "LIVE",
        "MUTATED"
      ]
    },
    "input_condition": {
      "enum": [
        "NORMAL",
        "BOUNDARY",
        "AMBIGUOUS",
        "INSUFFICIENT",
        "LOW_CONFIDENCE",
        "CONFLICTING",
        "NOISY",
        "ADVERSARIAL"
      ]
    },
    "input_ref": {
      "type": "string",
      "minLength": 1
    },
    "gold_ref": {
      "type": "string",
      "minLength": 1
    },
    "initial_prompt_slot_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_initial_result": {
      "type": "string",
      "minLength": 1
    },
    "injected_failure_reason_code": {
      "enum": [
        "SCHEMA_INVALID_JSON",
        "SCHEMA_REQUIRED_FIELD_MISSING",
        "SCHEMA_INVALID_ENUM",
        "SCHEMA_WRONG_TYPE",
        "SCHEMA_UNSUPPORTED_FIELD",
        "SCHEMA_VERSION_MISMATCH",
        "INTENT_GOAL_MISSING",
        "INTENT_COMPLETION_CRITERIA_MISSING",
        "INTENT_CONSTRAINT_MISSING",
        "INTENT_ENTRY_MODE_WRONG",
        "INTENT_AMBIGUITY_MISSED",
        "INTENT_OVER_CONFIRMATION",
        "INTENT_UNSUPPORTED_SCOPE",
        "ACQ_REQUIRED_SOURCE_MISSING",
        "ACQ_FORBIDDEN_SOURCE_INCLUDED",
        "ACQ_NO_FETCH_MISCLASSIFIED",
        "QUERY_USER_CONSTRAINT_MISSING",
        "QUERY_TOO_BROAD",
        "QUERY_TOO_NARROW",
        "QUERY_REPEATED_WITHOUT_CHANGE",
        "QUERY_SCOPE_EXPANSION_REQUIRES_CONFIRMATION",
        "QUERY_LOW_CONFIDENCE_RESULTS",
        "QUERY_NO_RESULTS",
        "QUERY_BUDGET_EXHAUSTED",
        "QUERY_DETAIL_FETCH_FAILED",
        "QUERY_AUTH_REQUIRED",
        "QUERY_RATE_LIMITED",
        "QUERY_PROVIDER_FAILED",
        "CTX_REQUIRED_EVIDENCE_MISSING",
        "CTX_HARD_NEGATIVE_SELECTED",
        "CTX_STALE_EVIDENCE_SELECTED",
        "CTX_CONFLICT_NOT_REPORTED",
        "CTX_LOW_CONFIDENCE_AUTO_SELECTED",
        "CTX_PROMPT_INJECTION_FOLLOWED",
        "CTX_TOKEN_BUDGET_EXCEEDED",
        "CTX_SUFFICIENCY_WRONG",
        "ANALYSIS_UNSUPPORTED_INFERENCE",
        "ANALYSIS_RELATION_MISSING",
        "ANALYSIS_CONFLICT_MISHANDLED",
        "ANALYSIS_DUPLICATE_MISCLASSIFIED",
        "ANALYSIS_SCHEDULE_RISK_MISCLASSIFIED",
        "ANALYSIS_NEEDS_MORE_DATA_MISSED",
        "PLAN_REQUIRED_ACTION_MISSING",
        "PLAN_EXCESS_ACTION",
        "PLAN_WRONG_TOOL",
        "PLAN_WRONG_EFFECT_TYPE",
        "PLAN_WRONG_TARGET",
        "PLAN_REQUIRED_EVIDENCE_MISSING",
        "PLAN_DEPENDENCY_INVALID",
        "PLAN_ARGUMENT_CONSTRAINT_VIOLATION",
        "PLAN_USER_SCOPE_VIOLATION",
        "PLAN_POLICY_RISK",
        "PLAN_ANSWER_ONLY_MISROUTED",
        "REVIEW_FALSE_PASS",
        "REVIEW_FALSE_BLOCK",
        "REVIEW_WRONG_ROUTE",
        "REVIEW_ERROR_NOT_LOCALIZED",
        "REVIEW_REPEATED_SAME_FAILURE",
        "AUTH_REQUIRED",
        "GOOGLE_READ_429",
        "GOOGLE_READ_5XX",
        "GOOGLE_WRITE_FAILED",
        "GOOGLE_WRITE_UNKNOWN_RESULT",
        "VERIFICATION_MISMATCH",
        "VERIFICATION_TIMEOUT",
        "SQLITE_BUSY",
        "SQLITE_DISK_FULL",
        "AUDIT_PERSIST_FAILED",
        "MCP_EXIT",
        "SSE_LOSS",
        "LAUNCHER_SHUTDOWN_TIMEOUT",
        null
      ]
    },
    "expected_retry_kind": {
      "enum": [
        "NONE",
        "SCHEMA_REPAIR",
        "SEMANTIC_REVISION",
        "WORKFLOW_REDIRECTION",
        "DETERMINISTIC_RETRY",
        "DETERMINISTIC_RECOVERY"
      ]
    },
    "expected_retry_prompt_slot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_final_result": {
      "type": "string",
      "minLength": 1
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "forbidden_transitions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grader_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "scenario_family_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_relation_family": {
      "type": "string",
      "minLength": 1
    },
    "capability_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
