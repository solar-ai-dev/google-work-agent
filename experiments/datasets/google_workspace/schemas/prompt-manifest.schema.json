{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/prompt-manifest.schema.json",
  "title": "PromptManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_bundle_version",
    "created_at",
    "slots"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "prompt_bundle_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "agent_role",
          "purpose",
          "version",
          "activation_status",
          "files",
          "input_schema",
          "output_schema",
          "content_hash"
        ],
        "properties": {
          "slot_id": {
            "type": "string"
          },
          "agent_role": {
            "enum": [
              "request_understanding",
              "acquisition",
              "context_retriever",
              "work_analysis",
              "planning",
              "review"
            ]
          },
          "purpose": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "activation_status": {
            "enum": [
              "DRAFT",
              "DEV_VALIDATED",
              "HOLDOUT_VALIDATED",
              "SAFETY_VALIDATED",
              "RUNTIME_ACTIVE"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "failure_reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "input_schema": {
            "type": "string"
          },
          "output_schema": {
            "type": "string"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
