{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/canonical-projection-v1.schema.json",
  "title": "CanonicalProjectionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_id",
    "case_id",
    "projection_kind",
    "applicable",
    "input_contract",
    "gold",
    "grader_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "projection_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "projection_kind": {
      "enum": [
        "USER_UNDERSTANDING",
        "ACQUISITION",
        "RETRIEVAL",
        "ANALYSIS",
        "PLANNING",
        "REVIEW",
        "ROUTING_TRAJECTORY",
        "E2E"
      ]
    },
    "applicable": {
      "type": "boolean"
    },
    "not_applicable_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_contract": {
      "type": "object"
    },
    "gold": {
      "type": "object"
    },
    "grader_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
