{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/action-plan-draft.schema.json",
  "title": "ActionPlanDraftV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "plan_id",
    "summary",
    "objective",
    "actions",
    "evidence_refs",
    "resource_refs",
    "confirmation"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "status": {
      "enum": [
        "PLAN_READY",
        "NEEDS_CONFIRMATION",
        "BLOCKED"
      ]
    },
    "plan_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "action_id",
          "position",
          "tool_name",
          "effect",
          "arguments",
          "expected",
          "evidence_refs",
          "resource_refs",
          "target_resource_ref_id",
          "depends_on_action_ids",
          "user_visible_reason"
        ],
        "properties": {
          "schema_version": {
            "const": 2
          },
          "action_id": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "tool_name": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "enum": [
              "READ",
              "CREATE",
              "UPDATE",
              "SEND",
              "DELETE"
            ]
          },
          "arguments": {
            "type": "object"
          },
          "expected": {
            "type": "object"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resource_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target_resource_ref_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "depends_on_action_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "user_visible_reason": {
            "type": "string"
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resource_refs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confirmation": {
      "type": [
        "object",
        "null"
      ]
    },
    "llm_provider_result": {
      "type": "object"
    }
  }
}
