{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/PlanningRepairInputV1.schema.json",
  "title": "PlanningRepairInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "original_input",
    "previous_output",
    "failure_record",
    "validator_errors",
    "changed_fields_allowed",
    "attempt_no",
    "max_attempts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "original_input": {
      "type": "object"
    },
    "previous_output": {
      "type": [
        "object",
        "string"
      ]
    },
    "failure_record": {
      "type": "object"
    },
    "validator_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_fields_allowed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    }
  },
  "description": "Bounded retry/revision prompt input. failure_reason_code is assembly metadata in failure_record, not part of the Runtime Prompt Slot key."
}
