{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-ready-evaluation-item-v1.schema.json",
  "title": "ContextReadyEvaluationItemV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_item_id",
    "contract_version",
    "context_snapshot_id",
    "source_case_id",
    "split",
    "model_input_ref",
    "grader_gold_ref",
    "execution_contract",
    "model_input_allowed_ref",
    "grader_only_ref"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evaluation_item_id": {
      "type": "string"
    },
    "contract_version": {
      "const": "CONTEXT_READY_V1"
    },
    "context_snapshot_id": {
      "type": "string"
    },
    "source_case_id": {
      "type": "string"
    },
    "split": {
      "const": "DEV"
    },
    "model_input_ref": {
      "type": "string"
    },
    "grader_gold_ref": {
      "type": "string"
    },
    "execution_contract": {
      "type": "object"
    },
    "model_input_allowed_ref": {
      "const": "model_input_ref_only"
    },
    "grader_only_ref": {
      "const": "grader_gold_ref"
    }
  }
}
