{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/clarification-question.schema.json",
  "title": "ClarificationQuestionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result",
    "ambiguity_kind",
    "question",
    "candidate_options",
    "allow_free_text",
    "required_response_fields",
    "resume_route"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "result": {
      "const": "QUESTION_READY"
    },
    "ambiguity_kind": {
      "enum": [
        "PERSON",
        "RESOURCE",
        "ACTION_SEMANTICS",
        "DATE_RANGE",
        "DURATION",
        "DESTINATION",
        "RECIPIENT_SCOPE",
        "RECURRENCE_SCOPE",
        "REFERENCE",
        "RELATION",
        "OTHER"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "candidate_options": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "label",
          "difference_summary",
          "resource_refs"
        ],
        "properties": {
          "option_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "difference_summary": {
            "type": "string"
          },
          "resource_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "allow_free_text": {
      "type": "boolean"
    },
    "required_response_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resume_route": {
      "const": "REQUEST_UNDERSTANDING"
    }
  }
}
