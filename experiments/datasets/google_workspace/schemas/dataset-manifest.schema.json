{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/dataset-manifest.schema.json",
  "title": "DatasetManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_version",
    "created_at",
    "source_contract_versions",
    "layers",
    "coverage_targets",
    "holdout_policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_contract_versions": {
      "type": "object"
    },
    "layers": {
      "type": "object"
    },
    "coverage_targets": {
      "type": "object"
    },
    "holdout_policy": {
      "type": "object"
    }
  }
}
