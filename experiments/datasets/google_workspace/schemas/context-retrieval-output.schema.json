{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/context-retrieval-output.schema.json",
  "title": "ContextRetrievalResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result",
    "selected_segment_ids",
    "evidence_drafts",
    "excluded_segment_ids",
    "conflicts",
    "ignored_untrusted_instruction_ids",
    "token_budget",
    "missing_slots",
    "confidence_band",
    "next_route"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "result": {
      "enum": [
        "SELECTED",
        "SUFFICIENT",
        "NEEDS_MORE_DATA",
        "NEEDS_CONFIRMATION",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "selected_segment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "segment_id",
          "resource_id",
          "claim",
          "excerpt",
          "confidence"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "segment_id": {
            "type": "string"
          },
          "resource_id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          }
        }
      }
    },
    "excluded_segment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "segment_ids",
          "resolution"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "segment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2
          },
          "resolution": {
            "type": "string"
          }
        }
      }
    },
    "ignored_untrusted_instruction_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "token_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_tokens",
        "used_tokens"
      ],
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "used_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "missing_slots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "confidence_band": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "NONE"
      ]
    },
    "next_route": {
      "enum": [
        "CONTINUE",
        "ACQUISITION",
        "CONFIRM",
        "BLOCK"
      ]
    }
  }
}
