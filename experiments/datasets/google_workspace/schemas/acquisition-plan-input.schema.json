{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/AcquisitionPlanInputV1.schema.json",
  "title": "AcquisitionPlanInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_intent",
    "entry_context",
    "retrieval_budget",
    "prior_query_attempts",
    "provider_outcomes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_intent": {
      "type": "object"
    },
    "entry_context": {
      "type": "object"
    },
    "retrieval_budget": {
      "type": "object"
    },
    "prior_query_attempts": {
      "type": "array"
    },
    "provider_outcomes": {
      "type": "array"
    }
  },
  "description": "Parent-supplied retrieval_budget is a hard ceiling. The LLM must not invent larger limits."
}
