{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/request-intent.schema.json",
  "title": "RequestIntentV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal",
    "completion_criteria",
    "semantic_constraints",
    "ambiguity",
    "unsupported_scope",
    "requested_effect_hints",
    "requested_resource_hints",
    "analysis_requirement"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "user_visible_objective"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "user_visible_objective": {
          "type": "string"
        }
      }
    },
    "completion_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "semantic_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topics",
        "people",
        "time",
        "sources",
        "status_or_state",
        "negative_constraints",
        "policy_or_safety_constraints"
      ],
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "people": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "time": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "status_or_state": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "negative_constraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "policy_or_safety_constraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "unsupported_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_unsupported",
        "reason_code",
        "explanation"
      ],
      "properties": {
        "is_unsupported": {
          "type": "boolean"
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "explanation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_ambiguous",
        "items"
      ],
      "properties": {
        "is_ambiguous": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "requested_effect_hints": {
      "type": "array",
      "items": {
        "enum": ["READ", "CREATE", "UPDATE", "SEND", "DELETE"]
      }
    },
    "requested_resource_hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "analysis_requirement": {
      "enum": ["NONE", "REQUIRED"]
    }
  }
}
