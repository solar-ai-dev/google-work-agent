{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-ready-input-v1.schema.json",
  "title": "ContextReadyInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "context_snapshot_id",
    "snapshot_origin",
    "source_case_id",
    "fixture_snapshot_id",
    "category",
    "split",
    "request_intent",
    "context_bundle",
    "evidence_set",
    "policy_summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "CONTEXT_READY_V1"
    },
    "context_snapshot_id": {
      "type": "string"
    },
    "snapshot_origin": {
      "const": "CANONICAL_GOLD_CONTEXT"
    },
    "source_case_id": {
      "type": "string"
    },
    "fixture_snapshot_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "split": {
      "const": "DEV"
    },
    "request_intent": {
      "type": "object"
    },
    "context_bundle": {
      "type": "object"
    },
    "evidence_set": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "policy_summary": {
      "type": "object"
    }
  }
}
