{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AmbiguityEvaluationItemV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_item_id",
    "split",
    "ambiguity_family_id",
    "user_request",
    "conversation_context",
    "available_candidates",
    "gold",
    "grader_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evaluation_item_id": {
      "type": "string"
    },
    "split": {
      "enum": [
        "DEV",
        "HOLDOUT"
      ]
    },
    "ambiguity_family_id": {
      "type": "string"
    },
    "user_request": {
      "type": "string"
    },
    "conversation_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "available_candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "gold": {
      "type": "object",
      "required": [
        "should_clarify",
        "ambiguity_kind",
        "expected_route",
        "expected_semantics",
        "question_strategy",
        "required_candidate_ids",
        "forbidden_assumptions"
      ],
      "properties": {
        "should_clarify": {
          "type": "boolean"
        },
        "ambiguity_kind": {
          "type": "string"
        },
        "expected_route": {
          "type": "string"
        },
        "expected_semantics": {
          "type": "string"
        },
        "question_strategy": {
          "type": "string"
        },
        "required_candidate_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "grader_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
