{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/fault-safety-item-v1.schema.json",
  "title": "FaultSafetyItemV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_item_id",
    "fault_profile_id",
    "source_case_id",
    "input_mode",
    "expected_disposition",
    "expected_run_status",
    "expected_action_status",
    "required_events",
    "forbidden_events",
    "grader_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evaluation_item_id": {
      "type": "string"
    },
    "fault_profile_id": {
      "type": "string"
    },
    "source_case_id": {
      "type": "string"
    },
    "input_mode": {
      "enum": [
        "MUTATED",
        "E2E_FAULT"
      ]
    },
    "expected_disposition": {
      "type": "string"
    },
    "expected_run_status": {
      "type": "string"
    },
    "expected_action_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grader_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
