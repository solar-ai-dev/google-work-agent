{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/e2e-projection-v2.schema.json",
  "title": "E2EProjectionV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_id",
    "case_id",
    "projection_kind",
    "applicable",
    "input_contract",
    "gold",
    "grader_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "projection_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "projection_kind": {
      "const": "E2E"
    },
    "applicable": {
      "const": true
    },
    "not_applicable_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_contract": {
      "type": "object"
    },
    "gold": {
      "type": "object",
      "required": [
        "expected_goal",
        "completion_criteria",
        "required_sources",
        "forbidden_sources",
        "required_resource_ids",
        "required_evidence_ids",
        "policy_result",
        "expected_interactions",
        "expected_semantic_milestones",
        "expected_planning_result_type",
        "allowed_actions",
        "forbidden_actions",
        "approval_expectation",
        "verification_expectation",
        "end_state_expectation"
      ],
      "additionalProperties": true
    },
    "grader_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
