{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/canonical-case.schema.json",
  "title": "CanonicalCaseV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "split",
    "scenario_family_id",
    "fixture_snapshot_id",
    "fixture_relation_family",
    "business_scenario",
    "canonical_user_prompt",
    "entry_mode",
    "requested_outcome",
    "expected_route",
    "expected_end_state",
    "required_resources",
    "forbidden_resources",
    "hard_negatives",
    "required_evidence",
    "expected_tool_trajectory",
    "node_projection_refs",
    "tags"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "CORE",
        "STRESS",
        "HOLDOUT"
      ]
    },
    "scenario_family_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_relation_family": {
      "type": "string",
      "minLength": 1
    },
    "business_scenario": {
      "type": "string",
      "minLength": 1
    },
    "canonical_user_prompt": {
      "type": "string",
      "minLength": 1
    },
    "entry_mode": {
      "enum": [
        "AGENT_SEARCH",
        "RESOURCE_SELECTED"
      ]
    },
    "requested_outcome": {
      "enum": [
        "ANSWER",
        "ANALYSIS",
        "ACTION_PLAN"
      ]
    },
    "expected_route": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "expected_end_state": {
      "type": "object",
      "required": [
        "run_status",
        "result_kind"
      ],
      "properties": {
        "run_status": {
          "enum": [
            "WAITING_CONFIRMATION",
            "WAITING_APPROVAL",
            "REAUTH_REQUIRED",
            "RECOVERY_REQUIRED",
            "COMPLETED",
            "BLOCKED",
            "FAILED",
            "CANCELLED"
          ]
        },
        "result_kind": {
          "enum": [
            "FULL",
            "PARTIAL",
            "NONE"
          ]
        }
      },
      "additionalProperties": true
    },
    "required_resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "forbidden_resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "hard_negatives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "expected_tool_trajectory": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "node_projection_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
