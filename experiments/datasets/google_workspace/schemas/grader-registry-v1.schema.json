{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GraderRegistryV1",
  "type": "object",
  "required": [
    "schema_version",
    "grader_registry_version",
    "graders"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "grader_registry_version": {
      "type": "string"
    },
    "graders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "grader_id",
          "version",
          "grader_type",
          "applies_to",
          "authoritativeness",
          "gold_fields",
          "output_schema",
          "rule_summary"
        ],
        "properties": {
          "grader_id": {
            "type": "string",
            "pattern": "^grader\\."
          },
          "version": {
            "type": "string"
          },
          "grader_type": {
            "enum": [
              "DETERMINISTIC",
              "SEMANTIC"
            ]
          },
          "applies_to": {
            "type": "string"
          },
          "authoritativeness": {
            "type": "string"
          },
          "gold_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_schema": {
            "type": "object"
          },
          "rule_summary": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
