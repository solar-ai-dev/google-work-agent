{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/ReviewRecheckInputV1.schema.json",
  "title": "ReviewRecheckInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_snapshot_id",
    "user_goal",
    "evidence",
    "plan",
    "prior_failure_signature",
    "revision_attempts_for_signature"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "fixture_snapshot_id": {
      "type": "string"
    },
    "user_goal": {
      "type": "string"
    },
    "evidence": {
      "type": "array"
    },
    "plan": {
      "type": "object"
    },
    "prior_failure_signature": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "policy_summary": {
      "type": "object"
    },
    "revision_history": {
      "type": "array"
    },
    "revision_attempts_for_signature": {
      "type": "integer",
      "minimum": 0
    }
  },
  "description": "Review recheck uses the normal review envelope plus a prior failure signature and revision-attempt count."
}
