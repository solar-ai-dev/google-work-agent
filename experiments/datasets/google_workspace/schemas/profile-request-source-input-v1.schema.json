{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile-request-source-input-v1.schema.json",
  "title": "ProfileRequestSourceInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "user_request",
    "entry_mode",
    "selected_resource_ids",
    "retrieval_budget",
    "policy_summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "user_request": {
      "type": "string",
      "minLength": 1
    },
    "entry_mode": {
      "enum": [
        "AGENT_SEARCH",
        "RESOURCE_SELECTED"
      ]
    },
    "selected_resource_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "retrieval_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_size",
        "max_pages_per_source",
        "max_detail_fetch_per_source",
        "max_acquisition_rounds",
        "max_additional_acquisitions"
      ],
      "properties": {
        "page_size": {
          "type": "integer",
          "minimum": 1
        },
        "max_pages_per_source": {
          "type": "integer",
          "minimum": 1
        },
        "max_detail_fetch_per_source": {
          "type": "integer",
          "minimum": 1
        },
        "max_acquisition_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "max_additional_acquisitions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "policy_summary": {
      "type": "object"
    }
  }
}
