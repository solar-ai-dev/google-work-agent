{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/canonical-case-v7.schema.json",
  "title": "CanonicalCaseV7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "split",
    "dataset_version",
    "category",
    "scenario_family_id",
    "fixture_relation_family",
    "fixture_snapshot_id",
    "language",
    "entry_mode",
    "user_prompt_id",
    "canonical_user_prompt",
    "business_scenario",
    "business_gold",
    "request_gold",
    "tool_route_gold",
    "retrieval_gold",
    "analysis_gold",
    "planning_gold",
    "review_gold",
    "interaction_gold",
    "workflow_gold",
    "safety_gold",
    "tags",
    "human_rubric",
    "end_state_gold"
  ],
  "properties": {
    "schema_version": {
      "const": 7
    },
    "case_id": {
      "type": "string"
    },
    "split": {
      "enum": [
        "CORE",
        "STRESS",
        "HOLDOUT"
      ]
    },
    "dataset_version": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "scenario_family_id": {
      "type": "string"
    },
    "fixture_relation_family": {
      "type": "string"
    },
    "fixture_snapshot_id": {
      "type": "string"
    },
    "language": {
      "enum": [
        "ko-KR",
        "en-US"
      ]
    },
    "entry_mode": {
      "enum": [
        "AGENT_SEARCH",
        "RESOURCE_SELECTED"
      ]
    },
    "user_prompt_id": {
      "type": "string"
    },
    "canonical_user_prompt": {
      "type": "string",
      "minLength": 1
    },
    "business_scenario": {
      "type": "string"
    },
    "business_gold": {
      "type": "object"
    },
    "request_gold": {
      "type": "object"
    },
    "tool_route_gold": {
      "type": "object"
    },
    "retrieval_gold": {
      "type": "object"
    },
    "analysis_gold": {
      "type": "object"
    },
    "planning_gold": {
      "type": "object"
    },
    "review_gold": {
      "type": "object"
    },
    "interaction_gold": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "type",
          "required",
          "interaction_id",
          "expected_user_decision",
          "post_decision_expectation"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "interaction_id": {
            "type": "string"
          },
          "expected_user_decision": {
            "type": [
              "string",
              "null"
            ]
          },
          "post_decision_expectation": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "workflow_gold": {
      "type": "object"
    },
    "safety_gold": {
      "type": "object"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_rubric": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "end_state_gold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "initial_fixture_snapshot_id",
        "completion_mode",
        "expected_mutations",
        "indeterminate_mutations",
        "forbidden_mutations",
        "terminal_expectation",
        "notes"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "initial_fixture_snapshot_id": {
          "type": "string"
        },
        "completion_mode": {
          "enum": [
            "ANSWER_ONLY",
            "ALL_REQUIRED_MUTATIONS",
            "PARTIAL_ALLOWED",
            "NO_MUTATION_EXPECTED",
            "INDETERMINATE_PENDING_RECOVERY"
          ]
        },
        "expected_mutations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "indeterminate_mutations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "forbidden_mutations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "terminal_expectation": {
          "type": "object",
          "required": [
            "run_status",
            "result_kind"
          ],
          "properties": {
            "run_status": {
              "type": "string"
            },
            "result_kind": {
              "enum": [
                "FULL",
                "PARTIAL",
                "NONE"
              ]
            }
          },
          "additionalProperties": false
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
