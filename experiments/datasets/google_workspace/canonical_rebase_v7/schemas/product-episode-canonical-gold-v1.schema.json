{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/product-episode-canonical-gold-v1.schema.json",
  "title": "ProductEpisodeCanonicalGoldV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "variant_id",
    "status",
    "source_refs",
    "fixture_snapshot_id",
    "user_prompt",
    "decision_script",
    "business_gold",
    "interaction_gold",
    "action_gold",
    "safety_gold",
    "end_state_gold"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "suite_id": {
      "const": "E_PRODUCT_EPISODE_EXTENSION_V1"
    },
    "variant_id": {
      "type": "string"
    },
    "status": {
      "const": "GOLD_REBASED_NOT_ACTIVE"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "fixture_snapshot_id": {
      "type": "string"
    },
    "user_prompt": {
      "type": "string"
    },
    "decision_script": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "business_gold": {
      "type": "object"
    },
    "interaction_gold": {
      "type": "array"
    },
    "action_gold": {
      "type": "array"
    },
    "safety_gold": {
      "type": "object"
    },
    "end_state_gold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "initial_fixture_snapshot_id",
        "completion_mode",
        "expected_mutations",
        "indeterminate_mutations",
        "forbidden_mutations",
        "terminal_expectation",
        "notes"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "initial_fixture_snapshot_id": {
          "type": "string"
        },
        "completion_mode": {
          "enum": [
            "ANSWER_ONLY",
            "ALL_REQUIRED_MUTATIONS",
            "PARTIAL_ALLOWED",
            "NO_MUTATION_EXPECTED",
            "INDETERMINATE_PENDING_RECOVERY"
          ]
        },
        "expected_mutations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "indeterminate_mutations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "forbidden_mutations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "terminal_expectation": {
          "type": "object",
          "required": [
            "run_status",
            "result_kind"
          ],
          "properties": {
            "run_status": {
              "type": "string"
            },
            "result_kind": {
              "enum": [
                "FULL",
                "PARTIAL",
                "NONE"
              ]
            }
          },
          "additionalProperties": false
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
