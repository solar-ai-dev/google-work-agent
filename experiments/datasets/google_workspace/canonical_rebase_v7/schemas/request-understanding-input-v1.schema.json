{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/request-understanding-input-v1.schema.json",
  "title": "request-understanding-input-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user_request",
    "entry_mode"
  ],
  "properties": {
    "user_request": {
      "type": "string",
      "minLength": 1
    },
    "entry_mode": {
      "type": "string",
      "enum": [
        "AGENT_SEARCH",
        "RESOURCE_SELECTED"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connector_id",
          "resource_type",
          "external_resource_id"
        ],
        "properties": {
          "connector_id": {
            "type": "string"
          },
          "resource_type": {
            "type": "string",
            "enum": [
              "EMAIL",
              "TASK",
              "CALENDAR"
            ]
          },
          "external_resource_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
