{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/tool-argument-candidate-v1.schema.json",
  "title": "ToolArgumentCandidateV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_id",
    "arguments",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "route_id": {
      "type": "string"
    },
    "arguments": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
