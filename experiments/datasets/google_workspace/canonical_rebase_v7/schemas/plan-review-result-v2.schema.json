{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/plan-review-result-v2.schema.json",
  "title": "PlanReviewResultV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "status": {
      "enum": [
        "PASS",
        "REVISE",
        "RETRIEVE_MORE",
        "ROUTE_RECONSIDERATION",
        "CONFIRM",
        "BLOCK"
      ]
    },
    "summary": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "route_issues": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confirmation": {
      "type": [
        "object",
        "null"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
