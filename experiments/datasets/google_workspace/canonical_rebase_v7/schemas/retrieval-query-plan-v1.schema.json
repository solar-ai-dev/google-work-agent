{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/retrieval-query-plan-v1.schema.json",
  "title": "RetrievalQueryPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_queries",
    "required_information",
    "retrieval_order"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "route_queries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "operation_kind",
          "reason_codes",
          "constraint_delta",
          "detail_candidate_ref"
        ],
        "properties": {
          "route_id": {
            "type": "string"
          },
          "operation_kind": {
            "enum": [
              "SEARCH",
              "NEXT_PAGE",
              "DETAIL_FETCH",
              "FREEBUSY"
            ]
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "constraint_delta": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["added_constraints", "removed_constraints"],
                "properties": {
                  "added_constraints": {"type": "array", "items": {"type": "string"}},
                  "removed_constraints": {"type": "array", "items": {"type": "string"}}
                }
              }
            ]
          },
          "detail_candidate_ref": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "required_information": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retrieval_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
