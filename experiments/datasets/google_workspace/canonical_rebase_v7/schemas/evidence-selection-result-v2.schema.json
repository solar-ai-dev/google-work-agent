{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/evidence-selection-result-v2.schema.json",
  "title": "EvidenceSelectionResultV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_drafts",
    "selected_segment_ids",
    "excluded_segment_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "evidence_drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "role",
          "relevance_reason"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "SUPPORTS",
              "CONTRADICTS",
              "CONTEXT"
            ]
          },
          "relevance_reason": {
            "type": "string"
          }
        }
      }
    },
    "selected_segment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "excluded_segment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
