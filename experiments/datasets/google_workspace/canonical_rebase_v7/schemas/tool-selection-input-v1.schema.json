{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/tool-selection-input-v1.schema.json",
  "title": "tool-selection-input-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route_id",
    "connector_id",
    "resource_type",
    "effect",
    "eligible_tool_ids"
  ],
  "properties": {
    "route_id": {
      "type": "string"
    },
    "connector_id": {
      "type": "string"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "EMAIL",
        "TASK",
        "CALENDAR"
      ]
    },
    "effect": {
      "type": "string",
      "enum": [
        "CREATE",
        "UPDATE",
        "SEND",
        "DELETE"
      ]
    },
    "eligible_tool_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
