{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/retrieval-query-plan-v2.schema.json",
  "title": "RetrievalQueryPlanV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "route_queries", "required_information", "retrieval_order"],
  "properties": {
    "schema_version": {"const": 2},
    "route_queries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "operation", "reason_codes", "search_spec", "detail_candidate_ref"],
        "properties": {
          "route_id": {"type": "string", "minLength": 1},
          "operation": {"enum": ["SEARCH", "NEXT_PAGE", "DETAIL_FETCH", "FREEBUSY"]},
          "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "search_spec": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/searchSpec"}]},
          "detail_candidate_ref": {"type": ["string", "null"]}
        }
      }
    },
    "required_information": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "retrieval_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "searchSpec": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode", "constraints"], "properties": {"mode": {"const": "INITIAL"}, "constraints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/constraint"}}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "constraint_delta"], "properties": {"mode": {"const": "CHANGED"}, "constraint_delta": {"type": "object", "additionalProperties": false, "required": ["upsert_constraints", "remove_constraint_kinds"], "properties": {"upsert_constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}}, "remove_constraint_kinds": {"type": "array", "items": {"enum": ["TEMPORAL_RANGE", "PARTICIPANT", "KEYWORD", "RESOURCE_REF", "CONTAINER_REF", "STATUS_SCOPE"]}}}}}}
      ]
    },
    "constraint": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["TEMPORAL_RANGE", "PARTICIPANT", "KEYWORD", "RESOURCE_REF", "CONTAINER_REF", "STATUS_SCOPE"]}}}
  }
}
