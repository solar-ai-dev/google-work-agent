{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/review-input-v1.schema.json",
  "title": "review-input-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user_request",
    "request_intent",
    "planning_result",
    "evidence",
    "policy_summary"
  ],
  "properties": {
    "user_request": {
      "type": "string"
    },
    "request_intent": {
      "$ref": "request-intent-v2.schema.json"
    },
    "output_plan": {
      "type": "object"
    },
    "planning_result": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_ref",
          "excerpt",
          "role"
        ],
        "properties": {
          "evidence_ref": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "SUPPORTS",
              "CONTRADICTS",
              "CONTEXT"
            ]
          },
          "resource_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "policy_summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
