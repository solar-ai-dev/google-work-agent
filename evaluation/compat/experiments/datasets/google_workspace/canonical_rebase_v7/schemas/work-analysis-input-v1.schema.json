{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/work-analysis-input-v1.schema.json",
  "title": "work-analysis-input-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user_request",
    "request_intent",
    "evidence"
  ],
  "properties": {
    "user_request": {
      "type": "string"
    },
    "request_intent": {
      "$ref": "request-intent-v2.schema.json"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_ref",
          "excerpt",
          "role"
        ],
        "properties": {
          "evidence_ref": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "SUPPORTS",
              "CONTRADICTS",
              "CONTEXT"
            ]
          },
          "resource_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "availability_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end",
          "timezone"
        ],
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "derived_from_resource_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "policy_confirmation_receipt_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
