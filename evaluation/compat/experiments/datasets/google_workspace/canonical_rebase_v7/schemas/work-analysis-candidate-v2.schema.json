{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://google-work-agent.local/schemas/work-analysis-candidate-v2.schema.json",
  "title": "WorkAnalysisCandidateV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_facts",
    "relation_candidates",
    "ambiguities",
    "risks",
    "evidence_refs",
    "disposition"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "work_facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "relation_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation_type",
          "left_ref",
          "right_ref",
          "evidence_refs"
        ],
        "properties": {
          "relation_type": {
            "type": "string"
          },
          "left_ref": {
            "type": "string"
          },
          "right_ref": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disposition": {
      "enum": [
        "COMPLETE",
        "NEEDS_MORE_DATA",
        "NEEDS_CONFIRMATION",
        "ROUTE_RECONSIDERATION_REQUIRED",
        "BLOCKED"
      ]
    }
  }
}
